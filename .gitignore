# ── 비밀 ─────────────────────────────────────────────────────────────────────
# GOOGLE_API_KEY 등이 들어 있다. 절대 커밋하지 말 것.
.env
.env.*
!.env.example
*.pem
*.key

# ── 파이썬 ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# ── Node ─────────────────────────────────────────────────────────────────────
node_modules/

# ── 생성 산출물 ──────────────────────────────────────────────────────────────
web_target/coverage/
web_target/dist/
dist/
build/
playwright-report/
test-results/

# ── 런타임 로그 ──────────────────────────────────────────────────────────────
*.log
harness_runtime.log
web_target/vite.log

# ── 에이전트 런타임 상태 ─────────────────────────────────────────────────────
# .harness_memory/ 자체는 추적한다 (반성 코퍼스는 분석 가치가 있다).
# 큐레이션된 증거는 troubleshooting/evidence/ 에 보존한다.
harness_graph.png

# ── OS / 에디터 ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp

# ── 검수 산출물 ──────────────────────────────────────────────────────────────
# `inspect --write-draft` 의 결과. 명세가 아니라 **검토 대기 중인 후보**이므로
# 추적하지 않는다 — 커밋되면 features.json 과 구분이 흐려질 위험이 있다.
features.draft.json

# ── 로컬 전용 설정 ───────────────────────────────────────────────────────────
.claude/settings.local.json
